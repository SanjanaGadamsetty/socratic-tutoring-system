<mxfile host="app.diagrams.net">
  <diagram id="database-schema" name="Database Schema">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Problems Table -->
        <mxCell id="problems" value="problems&#xa;---&#xa;id (PK)&#xa;title&#xa;problem_text&#xa;correct_answer&#xa;topic&#xa;difficulty&#xa;created_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="150" height="140" as="geometry"/>
        </mxCell>

        <!-- Sessions Table -->
        <mxCell id="sessions" value="sessions&#xa;---&#xa;id (PK)&#xa;problem_id (FK)&#xa;student_id&#xa;status&#xa;started_at&#xa;ended_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="150" height="140" as="geometry"/>
        </mxCell>

        <!-- Turns Table -->
        <mxCell id="turns" value="turns&#xa;---&#xa;id (PK)&#xa;session_id (FK)&#xa;turn_number&#xa;speaker (tutor/student)&#xa;message&#xa;timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="350" y="250" width="150" height="140" as="geometry"/>
        </mxCell>

        <!-- Hints Given Table -->
        <mxCell id="hints" value="hints_given&#xa;---&#xa;id (PK)&#xa;session_id (FK)&#xa;hint_level&#xa;hint_text&#xa;given_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="150" height="120" as="geometry"/>
        </mxCell>

        <!-- Verifier Flags Table -->
        <mxCell id="flags" value="verifier_flags&#xa;---&#xa;id (PK)&#xa;session_id (FK)&#xa;turn_id (FK)&#xa;rejected_message&#xa;reason&#xa;flagged_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="150" y="250" width="150" height="140" as="geometry"/>
        </mxCell>

        <!-- Relationships -->
        <mxCell id="rel1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="problems" target="sessions">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="sessions" target="turns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="sessions" target="hints">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="525" y="120"/>
              <mxPoint x="525" y="310"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rel4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="sessions" target="flags">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="155"/>
              <mxPoint x="320" y="320"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="PK = Primary Key&#xa;FK = Foreign Key&#xa;One-to-Many relationships shown" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="200" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
